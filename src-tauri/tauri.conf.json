{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dopagaki-board",
  "version": "0.1.0",
  "identifier": "uk.nasu.dopagakiboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "dopagaki-board · bootstrap",
        "width": 560,
        "height": 360,
        "minWidth": 360,
        "minHeight": 220,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
